# Discord Bot Token (from the Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# The ID of the channel where the digest will be posted
DIGEST_CHANNEL_ID=your_general_channel_id_here

# How often to post the digest (cron format, default is every 3 days at 9am)

# Digest schedule — change this to control how often the digest posts
# Every 3 days at 9am:  0 9 */3 * *
# Every 2 days at 9am:  0 9 */2 * *
# Every 1 day at 9am:   0 9 * * *

CRON_SCHEDULE=0 9 */3 * *